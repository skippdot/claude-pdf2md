[MAIN]
# PyMuPDF (fitz) and Pillow are C extensions; pylint can't introspect them.
extension-pkg-allow-list=fitz,PIL
generated-members=fitz.*,PIL.Image.*,metadata,page_count,load_page

[FORMAT]
max-line-length=120

[MESSAGES CONTROL]
# The project style keeps docstrings sparse by design — identifiers and
# short block comments carry the intent. The three docstring rules are
# disabled to avoid drowning real signal in noise.
# `import-outside-toplevel` is disabled because `weasyprint` / `markdown_it`
# live in the [diff] extra and are lazy-imported inside functions.
# The three `too-many-*` entries cover dense PDF-parsing state machines where
# splitting would hurt clarity more than it helps.
disable=
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    import-outside-toplevel,
    too-many-locals,
    too-many-return-statements,
    too-many-boolean-expressions

[DESIGN]
# The `Block` dataclass in model.py carries 9 fields, one per kind of payload
# a PDF block can hold (lines / bbox / level / table / image / etc.).
max-attributes=12

[SIMILARITIES]
min-similarity-lines=8
ignore-comments=yes
ignore-docstrings=yes
ignore-imports=yes
